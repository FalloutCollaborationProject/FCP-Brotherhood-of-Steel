    <!-- Patrol Knight -->

    <PawnKindDef ParentName="FCP_BoSkindBase">
        <defName>FCP_Pawnkind_HiddenValley_Knight</defName>
        <label>Brotherhood Knight</label>
        <combatPower>60</combatPower>
        <gearHealthRange>0.6~1.9</gearHealthRange>
        <weaponMoney>900~1600</weaponMoney>
