<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Lost Hills Rank Perks __________-->

    <HediffDef Name="FCP_Hediff_LostHills_RankBase" Abstract="True">
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_Knight</defName>
        <label>Western Chapter Knight training</label>
        <description>Commissioned combat duty: armory, escort, and gate service under a Paladin's authority.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
                    <MeleeHitChance>2</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_Paladin</defName>
        <label>Western Chapter Paladin training</label>
        <description>Elite combat drilling, skipping straight past the formalities other chapters bother with.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>7</ShootingAccuracyPawn>
                    <MeleeHitChance>4</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_Scribe</defName>
        <label>Western Chapter Scribe training</label>
        <description>Exacting archival training under the keepers of the original Codex.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.09</ResearchSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_SeniorScribe</defName>
        <label>Western Chapter Senior Scribe training</label>
        <description>Trusted with real research projects and the diagnostics that keep the bunker running.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.14</ResearchSpeed>
                    <MedicalSurgerySuccessChance>0.05</MedicalSurgerySuccessChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_SeniorPaladin</defName>
        <label>Western Chapter Senior Paladin training</label>
        <description>Independent command experience over Western Chapter patrols.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>9</ShootingAccuracyPawn>
                    <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_HeadPaladin</defName>
        <label>Western Chapter Head Paladin training</label>
        <description>Command of every Knight and Paladin the Western Chapter fields.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>11</ShootingAccuracyPawn>
                    <SocialImpact>0.1</SocialImpact>
                    <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_HeadScribe</defName>
        <label>Western Chapter Head Scribe training</label>
        <description>Trust over the original Codex itself, second only to the Elder.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.2</ResearchSpeed>
                    <SocialImpact>0.1</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_LostHills_RankBase">
        <defName>FCP_Hediff_LostHills_Rank_Elder</defName>
        <label>Western Chapter Elder training</label>
        <description>Supreme authority claimed over every Brotherhood chapter.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.12</ResearchSpeed>
                    <SocialImpact>0.12</SocialImpact>
                    <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!-- Elder Presence Aura -->

    <HediffDef>
        <defName>FCP_Hediff_LostHills_Elder_Presence</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>the Elder's presence</label>
        <description>The Western Chapter's Elder leads from the field. Nearby Brothers fight with steadier hands.</description>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>310</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>0.2</MoveSpeed>
                    <MeleeHitChance>3</MeleeHitChance>
                    <MeleeDodgeChance>0.05</MeleeDodgeChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!-- Elder Rally -->

    <HediffDef>
        <defName>FCP_Hediff_LostHills_Elder_Rally</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>rallied</label>
        <description>The Elder has called the Western Chapter to arms. A surge of speed and morale answers the call.</description>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>2500</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>1</MoveSpeed>
                    <MeleeDodgeChance>0.1</MeleeDodgeChance>
                    <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>
