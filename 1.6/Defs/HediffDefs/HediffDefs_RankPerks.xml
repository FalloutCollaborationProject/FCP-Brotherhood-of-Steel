<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Rank Perks __________-->

    <HediffDef Name="FCP_Hediff_BoS_RankBase" Abstract="True">
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_KnightInitiate</defName>
        <label>Knight Initiate training</label>
        <description>Basic power armor drilling has sharpened this pawn's aim.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>1</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_ScribeInitiate</defName>
        <label>Scribe Initiate training</label>
        <description>Archive work has sharpened this pawn's research instincts.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.03</ResearchSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Knight</defName>
        <label>Knight training</label>
        <description>Full combat training with the Brotherhood's power armor doctrine.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Scribe</defName>
        <label>Scribe training</label>
        <description>Full technical training in the preservation of pre-War technology.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.05</ResearchSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_SeniorKnight</defName>
