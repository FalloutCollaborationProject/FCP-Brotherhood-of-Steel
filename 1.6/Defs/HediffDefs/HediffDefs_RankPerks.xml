        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_SeniorScribe</defName>
        <label>Senior Scribe training</label>
        <description>Leadership on real projects has sharpened this pawn's technical eye.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.08</ResearchSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_KnightCommander</defName>
        <label>Knight Commander training</label>
        <description>Command experience over a full squad in the field.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
                    <SocialImpact>0.05</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Paladin</defName>
        <label>Paladin training</label>
        <description>Elite combat training and tactical command experience.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
                    <MeleeHitChance>5</MeleeHitChance>
                    <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_SeniorPaladin</defName>
        <label>Senior Paladin training</label>
