            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>7</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_HeadPaladin</defName>
