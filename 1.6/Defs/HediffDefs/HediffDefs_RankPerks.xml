        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Proctor</defName>
        <label>Proctor training</label>
        <description>Oversight of an entire order of Scribes.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.12</ResearchSpeed>
                    <SocialImpact>0.08</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_StarPaladin</defName>
        <label>Star Paladin training</label>
        <description>Selected for extraordinary service and critical missions.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>9</ShootingAccuracyPawn>
                    <MeleeHitChance>8</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Sentinel</defName>
        <label>Sentinel training</label>
        <description>The chapter's most distinguished and experienced soldier.</description>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>10</ShootingAccuracyPawn>
                    <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_HeadScribe</defName>
        <label>Head Scribe training</label>
        <description>The chapter's highest civilian authority.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.18</ResearchSpeed>
                    <SocialImpact>0.1</SocialImpact>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="FCP_Hediff_BoS_RankBase">
        <defName>FCP_Hediff_BoS_Rank_Elder</defName>
        <label>Elder training</label>
        <description>Command of an entire Brotherhood chapter.</description>
        <stages>
            <li>
                <statOffsets>
                    <ResearchSpeed>0.1</ResearchSpeed>
                    <SocialImpact>0.1</SocialImpact>
                    <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!-- Elder Presence Aura -->

    <HediffDef>
        <defName>FCP_Hediff_BoS_Elder_Presence</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>Elder's presence</label>
        <description>The Elder leads from the field. Nearby Brotherhood members fight with steadier hands.</description>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>310</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>0.2</MoveSpeed>
                    <MeleeHitChance>3</MeleeHitChance>
                    <MeleeDodgeChance>0.05</MeleeDodgeChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!-- Elder Rally -->

    <HediffDef>
        <defName>FCP_Hediff_BoS_Elder_Rally</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>rallied</label>
        <description>The Elder has called the chapter to arms. A surge of speed and morale answers the call.</description>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>2500</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>1</MoveSpeed>
                    <MeleeDodgeChance>0.1</MeleeDodgeChance>
                    <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>
