<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Midwestern Brotherhood Rank Expeditions __________-->

    <!-- Novice -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Midwest_Novice</defName>
        <label>frontier patrol</label>
        <description>A short patrol along the Vanguard's ever-expanding frontier to scout for salvage and new ground worth holding.</description>
        <durationDays>3~5</durationDays>
        <xpReward>
            <Shooting>200</Shooting>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>50~150</lootMarketValueRange>
        <siteRevealChance>0.15</siteRevealChance>
        <failureChance>0.12</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Midwest_Novice_1</li>
            <li>FCP_Rank_Expedition_Midwest_Novice_2</li>
            <li>FCP_Rank_Expedition_Midwest_Novice_3</li>
            <li>FCP_Rank_Expedition_Midwest_Novice_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Veteran -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Midwest_Veteran</defName>
        <label>expansion campaign</label>
        <description>A tasked operation to secure new territory for the Vanguard, welcoming any worthy recruits found along the way.</description>
        <durationDays>6~8</durationDays>
        <xpReward>
            <Shooting>400</Shooting>
            <Social>150</Social>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>150~350</lootMarketValueRange>
        <siteRevealChance>0.25</siteRevealChance>
        <failureChance>0.1</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Midwest_Veteran_1</li>
            <li>FCP_Rank_Expedition_Midwest_Veteran_2</li>
            <li>FCP_Rank_Expedition_Midwest_Veteran_3</li>
            <li>FCP_Rank_Expedition_Midwest_Veteran_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Elite -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Midwest_Elite</defName>
        <label>vanguard operation</label>
        <description>A solo operation deep into unclaimed territory, the kind only a proven Paladin is trusted to run alone.</description>
        <durationDays>8~10</durationDays>
        <xpReward>
            <Shooting>600</Shooting>
            <Social>200</Social>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>300~600</lootMarketValueRange>
        <siteRevealChance>0.35</siteRevealChance>
        <failureChance>0.08</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Midwest_Elite_1</li>
            <li>FCP_Rank_Expedition_Midwest_Elite_2</li>
            <li>FCP_Rank_Expedition_Midwest_Elite_3</li>
            <li>FCP_Rank_Expedition_Midwest_Elite_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Sentinel -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Midwest_Sentinel</defName>
        <label>territorial expedition</label>
        <description>A long-range expedition into unclaimed wasteland, the kind of mission that decides whether new ground is worth the Vanguard's flag.</description>
        <durationDays>10~14</durationDays>
        <xpReward>
            <Shooting>800</Shooting>
            <Social>250</Social>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>500~900</lootMarketValueRange>
        <siteRevealChance>0.5</siteRevealChance>
        <failureChance>0.05</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Midwest_Sentinel_1</li>
            <li>FCP_Rank_Expedition_Midwest_Sentinel_2</li>
            <li>FCP_Rank_Expedition_Midwest_Sentinel_3</li>
            <li>FCP_Rank_Expedition_Midwest_Sentinel_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

</Defs>
