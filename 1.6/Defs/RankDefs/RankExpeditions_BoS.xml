<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Rank Expeditions __________-->

    <!-- Loot -->

    <ThingSetMakerDef>
        <defName>FCP_BoSExpeditionLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>FCP_Currency_BoS_Scrip</li>
                        <li>Steel</li>
                        <li>ComponentIndustrial</li>
                        <li>MedicineIndustrial</li>
                        <li>Neutroamine</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

    <!-- Novice -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_BoS_Novice</defName>
        <label>scouting run</label>
        <description>A short patrol into the wastes to scout for salvage and threats.</description>
        <durationDays>3~5</durationDays>
        <xpReward>
            <Shooting>200</Shooting>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>50~150</lootMarketValueRange>
        <siteRevealChance>0.15</siteRevealChance>
        <failureChance>0.12</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Novice_1</li>
            <li>FCP_Rank_Expedition_Novice_2</li>
            <li>FCP_Rank_Expedition_Novice_3</li>
            <li>FCP_Rank_Expedition_Novice_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Veteran -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_BoS_Veteran</defName>
        <label>recovery operation</label>
        <description>A longer operation into contested territory to recover pre-War technology.</description>
        <durationDays>6~8</durationDays>
        <xpReward>
            <Shooting>400</Shooting>
            <Intellectual>150</Intellectual>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>150~350</lootMarketValueRange>
        <siteRevealChance>0.25</siteRevealChance>
        <failureChance>0.1</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Veteran_1</li>
            <li>FCP_Rank_Expedition_Veteran_2</li>
            <li>FCP_Rank_Expedition_Veteran_3</li>
            <li>FCP_Rank_Expedition_Veteran_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Elite -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_BoS_Elite</defName>
        <label>deep strike</label>
        <description>A solo operation deep into dangerous territory, the kind only a proven veteran is trusted to run alone.</description>
        <durationDays>8~10</durationDays>
        <xpReward>
            <Shooting>600</Shooting>
            <Intellectual>200</Intellectual>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>300~600</lootMarketValueRange>
        <siteRevealChance>0.35</siteRevealChance>
        <failureChance>0.08</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Elite_1</li>
            <li>FCP_Rank_Expedition_Elite_2</li>
            <li>FCP_Rank_Expedition_Elite_3</li>
            <li>FCP_Rank_Expedition_Elite_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Sentinel-tier -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_BoS_Sentinel</defName>
        <label>vanguard expedition</label>
        <description>A long-range expedition into unmapped wasteland, the kind of mission that finds new ground worth claiming.</description>
        <durationDays>10~14</durationDays>
        <xpReward>
            <Shooting>800</Shooting>
            <Intellectual>250</Intellectual>
        </xpReward>
        <lootMaker>FCP_BoSExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>500~900</lootMarketValueRange>
        <siteRevealChance>0.5</siteRevealChance>
        <failureChance>0.05</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Sentinel_1</li>
            <li>FCP_Rank_Expedition_Sentinel_2</li>
            <li>FCP_Rank_Expedition_Sentinel_3</li>
            <li>FCP_Rank_Expedition_Sentinel_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

</Defs>
