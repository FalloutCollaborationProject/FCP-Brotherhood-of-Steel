    <!-- High Elder John Maxson -->

    <PawnKindDef ParentName="FCP_BoSkindBase">
        <defName>FCP_Unique_Pawnkind_HighElder_John_Maxson</defName>
        <label>High Elder John Maxson</label>
        <defaultFactionDef>FCP_Faction_BoS_Lost_Hills</defaultFactionDef>
        <factionLeader>true</factionLeader>
        <combatPower>105</combatPower>
        <itemQuality>Legendary</itemQuality>
        <gearHealthRange>1.0~1.0</gearHealthRange>
        <apparelRequired>
            <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Power_Armor_Frame</li>
            <li>FCP_Apparel_BoS_Jumpsuit</li>
            <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_BoS_Lost_Hills_T51_Power_Armor</li>
            <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Power_Armor_T51_Helmet</li>
        </apparelRequired>
        <forcedTraits>
            <FCP_Trait_Power_Armor_Trained />
        </forcedTraits>
        <weaponMoney>2400~3200</weaponMoney>
        <weaponTags>
            <li MayRequire="Rick.FCP.EnergyWeapons">FCP_Heavy_Laser_Weapon</li>
        </weaponTags>
        <initialWillRange>7~8</initialWillRange>
        <initialResistanceRange>34~44</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Character_Backstory_HighElder_Maxson_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Character_Backstory_HighElder_Maxson_Adult</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <inventoryOptions>
            <skipChance>0.0</skipChance>
            <subOptionsChooseOne>
                <li>
                    <thingDef>FCP_Currency_BoS_Scrip</thingDef>
                    <countRange>150~250</countRange>
                </li>
                <li>
                    <thingDef>MealSurvivalPack</thingDef>
                    <countRange>4~6</countRange>
                </li>
                <li>
                    <thingDef>MedicineIndustrial</thingDef>
                    <countRange>3~5</countRange>
                </li>
                <li MayRequire="Rick.FCP.Chems">
                    <thingDef>FCP_Chem_Stimpak</thingDef>
                    <countRange>3~4</countRange>
                </li>
                <li MayRequire="Rick.FCP.Chems">
                    <thingDef>FCP_Chem_MedX</thingDef>
                    <countRange>2~3</countRange>
